# ==============================
# Python-generated files
# ==============================

# Python bytecode cache directories.
# These are generated automatically and can always be recreated.
__pycache__/

# Compiled Python bytecode files.
*.py[cod]

# Package metadata generated during installation/build.
*.egg-info/


# ==============================
# Jupyter-generated files
# ==============================

# Temporary checkpoint files created automatically by Jupyter notebooks.
.ipynb_checkpoints/


# ==============================
# Development tool caches
# ==============================

# Cache generated by pytest.
.pytest_cache/

# Cache generated by Ruff linter/formatter.
.ruff_cache/


# ==============================
# macOS system files
# ==============================

# Hidden metadata file automatically created by macOS Finder.
.DS_Store


# ==============================
# Experimental data
# ==============================

# Local raw or processed experimental data.
# Experimental datasets can be very large and should not be stored in Git.
data/


# ==============================
# Generated analysis outputs
# ==============================

# Figures, processed results, exported tables, videos, etc.
# These should be reproducible from the raw data and code.
outputs/

# Generated video files.
*.mp4


# ==============================
# Local IDE configuration
# ==============================

# User-specific VS Code settings.
# These may differ between developers and computers.
.vscode/